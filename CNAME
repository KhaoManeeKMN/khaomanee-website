.buy,.x,.telegram{

display:inline-block;
padding:18px 38px;
border-radius:14px;
font-weight:700;
text-decoration:none;
transition:.3s;

}

.buy{

background:linear-gradient(90deg,#8a2cff,#00d9ff);
color:white;

}

.buy:hover{

transform:translateY(-4px);
box-shadow:0 0 25px #8a2cff;

}

.x{

background:rgba(255,255,255,.08);
border:1px solid rgba(255,255,255,.15);
color:white;

}

.telegram{

background:#1d9bf0;
color:white;

}

section{

padding:120px 8%;

}

h2{

font-size:42px;
text-align:center;
margin-bottom:40px;

}

.glass{

max-width:900px;
margin:auto;
padding:40px;
background:rgba(255,255,255,.05);
border:1px solid rgba(255,255,255,.08);
backdrop-filter:blur(18px);
border-radius:25px;

}

.contract{

margin-top:25px;
display:flex;
justify-content:space-between;
align-items:center;
gap:15px;
padding:20px;
background:#111827;
border-radius:15px;
word-break:break-all;

}

.contract button{

padding:12px 20px;
border:none;
border-radius:10px;
cursor:pointer;
font-weight:700;
background:#8a2cff;
color:white;

}

.cards{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:25px;
margin-top:40px;

}

.card{

padding:35px;
text-align:center;
border-radius:20px;
background:rgba(255,255,255,.05);
border:1px solid rgba(255,255,255,.08);
font-size:22px;
transition:.3s;

}

.card:hover{

transform:translateY(-8px);

}

.socials{

display:flex;
justify-content:center;
gap:25px;
flex-wrap:wrap;
margin-top:40px;

}

.socials a{

padding:18px 30px;
background:#8a2cff;
border-radius:14px;
color:white;
text-decoration:none;
font-weight:700;

}

footer{

padding:50px;
text-align:center;
opacity:.7;

}

@media(max-width:768px){

.hero h1{

font-size:46px;

}

.hero h2{

font-size:24px;

}

.hero-logo{

width:180px;

}

nav{

flex-direction:column;
gap:20px;

}

nav ul{

gap:15px;
flex-wrap:wrap;
justify-content:center;

}

}
